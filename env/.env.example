# 本地开发默认 SQLite, 无需配置
# Docker/生产: 指向 PostgreSQL
DATABASE_URL=postgresql+psycopg://migration:migration@localhost:5432/migration
APP_VERSION=1.0.0
# 迁移计划后台编排 worker 的轮询间隔(秒); 设 PLAN_WORKER_ENABLED=0 可关闭(测试用)
PLAN_WORKER_POLL_INTERVAL=0.5
# 回放 worker: 同时处于执行中的回放任务上限(超出的任务排队, 恢复也重新受此闸门约束)
REPLAY_MAX_CONCURRENCY=2
REPLAY_WORKER_POLL_INTERVAL=0.5
# 归档 worker: 同时处于执行中的归档任务上限(超出的任务排队, 恢复也重新受此闸门约束)
ARCHIVE_MAX_CONCURRENCY=2
ARCHIVE_WORKER_POLL_INTERVAL=0.5
# 不可变归档包(zip)落盘目录
ARCHIVE_STORE_DIR=./archive_store
# 归档清理 worker: 轮询间隔与每个 tick 至多处理的归档项数(暂停/取消在逐项边界生效)
CLEANUP_WORKER_POLL_INTERVAL=0.5
CLEANUP_ITEMS_PER_TICK=5
# 审计补偿 worker: 同时处于执行/撤销中的补偿任务上限与轮询间隔
COMPENSATION_MAX_CONCURRENCY=2
COMPENSATION_WORKER_POLL_INTERVAL=0.5
# 回放快照默认有效期(秒), 过期快照拒绝执行补偿(撤销不受限)
AUDIT_SNAPSHOT_TTL_SECONDS=86400
# 显式补录事件允许的乱序时钟偏移(秒), 超过即拒绝
AUDIT_MAX_OUT_OF_ORDER_SECONDS=300
# 审计证据导出: 分段大小/默认页大小/并发上限/轮询间隔/包落盘目录/下载令牌 TTL
EVIDENCE_SEGMENT_SIZE=200
EVIDENCE_PAGE_LIMIT=100
EVIDENCE_EXPORT_MAX_CONCURRENCY=2
EVIDENCE_WORKER_POLL_INTERVAL=0.5
EVIDENCE_STORE_DIR=./evidence_store
EVIDENCE_DOWNLOAD_TTL_SECONDS=600
# EVIDENCE_CURSOR_SECRET=change-me   # 不配置则按 DATABASE_URL 派生游标 HMAC 密钥
# 证据封存分发: 分发包落盘目录 / 默认有效期(秒) / 一次性下载令牌 TTL / 离线签名密钥
EVIDENCE_DISTRIBUTION_STORE_DIR=./evidence_store
EVIDENCE_DISTRIBUTION_TTL_SECONDS=604800
EVIDENCE_DISTRIBUTION_DOWNLOAD_TTL_SECONDS=600
# EVIDENCE_DISTRIBUTION_SIGNING_KEY=change-me  # 不配置则按 DATABASE_URL 派生 HMAC 密钥
